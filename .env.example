# ==========================================
# FinPay QA Lab Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
APP_NAME="FinPay QA Lab"
DEBUG=true

# Database (PostgreSQL default for Docker Compose, SQLite supported for portable local testing)
# PostgreSQL in Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/finpay_db
# PostgreSQL Local:    postgresql+asyncpg://postgres:postgres@localhost:5432/finpay_db
# SQLite Local:        sqlite+aiosqlite:///finpay.db
DATABASE_URL=sqlite+aiosqlite:///finpay.db

# Security & JWT
JWT_SECRET_KEY=super-secret-finpay-jwt-key-for-qa-testing-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Webhook Secret for Payment Provider
WEBHOOK_SECRET=payment-provider-hmac-secret-finpay-2026

# ==========================================
# BUG_MODE: Defect Injection Flags (QA Practice)
# ==========================================
# Master switch: Enables all 10 realistic defects when set to true
BUG_MODE=false

# Granular defect toggles (ignored if BUG_MODE=true, otherwise evaluated individually)
BUG_001_DUPLICATE_TRANSFER=false
BUG_002_DUPLICATE_WEBHOOK=false
BUG_003_EXPIRED_TOKEN_ALLOWED=false
BUG_004_NEGATIVE_TRANSFER_ALLOWED=false
BUG_005_PAGINATION_DUPLICATES=false
BUG_006_SELF_TRANSFER_ALLOWED=false
BUG_007_WRONG_CURRENCY_RATE=false
BUG_008_TRANSACTION_STUCK_PENDING=false
BUG_009_LOCKED_USER_CAN_LOGIN=false
BUG_010_UI_BALANCE_NOT_REFRESHED=false
